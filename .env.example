# Database# Environment variables

DB_TYPE=postgres.env

DB_HOST=localhost.env.local

DB_PORT=5432.env.*.local

DB_USERNAME=postgres

DB_PASSWORD=postgres# Dependencies

DB_DATABASE=erp_dbnode_modules/

DB_SYNCHRONIZE=true

DB_LOGGING=true# Build output

dist/

# JWTbuild/

JWT_SECRET=your-secret-key-change-in-production

JWT_EXPIRES_IN=24h# Logs

logs

# Application*.log

PORT=3000npm-debug.log*

NODE_ENV=developmentpnpm-debug.log*

yarn-debug.log*

# RabbitMQyarn-error.log*

RABBITMQ_URL=amqp://localhost:5672

RABBITMQ_QUEUE_SALES=sales_queue# OS

RABBITMQ_QUEUE_INVENTORY=inventory_queue.DS_Store

RABBITMQ_QUEUE_NOTIFICATIONS=notifications_queue

RABBITMQ_EXCHANGE=erp_exchange# Tests

coverage/

# Email (for notification examples).nyc_output/

EMAIL_HOST=smtp.gmail.com

EMAIL_PORT=587# IDE

EMAIL_USER=your-email@gmail.com.idea/

EMAIL_PASSWORD=your-app-password.vscode/

EMAIL_FROM=noreply@yourapp.com*.swp

*.swo
*.swn
